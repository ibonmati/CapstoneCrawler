{
    "name": "Python 3",
    "image": "mcr.microsoft.com/devcontainers/python:3.12",
    "remoteUser": "vscode",
    "workspaceFolder": "/workspaces/CapstoneCrawler",
    "mounts": [
        "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,consistency=cached",
        "source=${env:XDG_RUNTIME_DIR}/wayland-0,target=/tmp/wayland-0,type=bind,consistency=cached"
    ],
    "containerEnv": {
        "DISPLAY": "${env:DISPLAY}",
        "WAYLAND_DISPLAY": "wayland-0"
    }
}